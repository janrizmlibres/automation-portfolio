<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Automation Specialist</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #0a0e27;
            color: #e2e8f0;
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Animated grid background */
        .grid-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 20s linear infinite;
            z-index: 0;
        }

        @keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        /* Glowing orbs */
        .orb-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.4;
            animation: float 25s infinite ease-in-out;
        }

        .orb1 {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, #00ffff, transparent);
            top: -10%;
            left: -10%;
            animation-delay: 0s;
        }

        .orb2 {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, #ff00ff, transparent);
            bottom: -10%;
            right: -10%;
            animation-delay: 8s;
        }

        .orb3 {
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, #00ff88, transparent);
            top: 40%;
            left: 50%;
            animation-delay: 16s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            25% { transform: translate(100px, -80px) rotate(90deg); }
            50% { transform: translate(-50px, 100px) rotate(180deg); }
            75% { transform: translate(80px, 50px) rotate(270deg); }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        header {
            text-align: center;
            padding: 3rem 0 2rem;
            animation: glitchIn 1s ease-out;
        }

        @keyframes glitchIn {
            0% { 
                opacity: 0; 
                transform: translateY(-50px);
                filter: blur(10px);
            }
            50% {
                transform: translateY(-50px) translateX(-5px);
            }
            100% { 
                opacity: 1; 
                transform: translateY(0);
                filter: blur(0);
            }
        }

        h1 {
            font-size: 3.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #00ffff 0%, #ff00ff 50%, #00ff88 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1rem;
            animation: colorShift 5s ease-in-out infinite;
            background-size: 200% 200%;
            text-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
        }

        @keyframes colorShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .subtitle {
            font-size: 1.5rem;
            color: #00ffff;
            margin-bottom: 0.5rem;
            animation: pulse 3s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .tagline {
            font-size: 1.1rem;
            color: #94a3b8;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Profile Section */
        .profile-section {
            display: flex;
            gap: 3rem;
            align-items: center;
            background: rgba(10, 14, 39, 0.8);
            backdrop-filter: blur(20px);
            border: 2px solid transparent;
            border-radius: 20px;
            padding: 3rem;
            margin: 2rem 0;
            position: relative;
            overflow: hidden;
            animation: slideInLeft 1s ease-out;
        }

        .profile-section::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 20px;
            padding: 2px;
            background: linear-gradient(135deg, #00ffff, #ff00ff, #00ff88, #00ffff);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            animation: borderRotate 4s linear infinite;
            background-size: 300% 300%;
        }

        @keyframes borderRotate {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .profile-image-container {
            flex-shrink: 0;
            position: relative;
        }

        .profile-image {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1a1f3a 0%, #2d1f3a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            position: relative;
            overflow: hidden;
        }

        .profile-image::before {
            content: '';
            position: absolute;
            inset: -10px;
            border-radius: 50%;
            background: conic-gradient(from 0deg, #00ffff, #ff00ff, #00ff88, #00ffff);
            animation: spin 3s linear infinite;
            z-index: -1;
        }

        .profile-image::after {
            content: '';
            position: absolute;
            inset: 4px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1a1f3a 0%, #2d1f3a 100%);
            z-index: -1;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .profile-content {
            flex: 1;
        }

        .profile-name {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #00ffff, #ff00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .profile-content h2 {
            font-size: 2rem;
            color: #00ffff;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .profile-content p {
            color: #cbd5e1;
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }

        .tools {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .tool-badge {
            background: rgba(0, 255, 255, 0.1);
            border: 2px solid #00ffff;
            color: #00ffff;
            padding: 0.5rem 1.2rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .tool-badge::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.3), transparent);
            transition: left 0.5s ease;
        }

        .tool-badge:hover::before {
            left: 100%;
        }

        .tool-badge:hover {
            background: rgba(0, 255, 255, 0.2);
            transform: translateY(-3px);
            box-shadow: 0 5px 20px rgba(0, 255, 255, 0.4);
        }

        .section {
            background: rgba(10, 14, 39, 0.8);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(0, 255, 255, 0.2);
            border-radius: 20px;
            padding: 3rem;
            margin: 2rem 0;
            animation: slideInRight 1s ease-out;
            position: relative;
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        h2 {
            font-size: 2rem;
            color: #ff00ff;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .service-card {
            background: linear-gradient(135deg, rgba(0, 255, 255, 0.05), rgba(255, 0, 255, 0.05));
            border: 2px solid transparent;
            border-radius: 15px;
            padding: 2rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            animation: fadeInScale 0.6s ease-out backwards;
        }

        .service-card:nth-child(1) { animation-delay: 0.1s; }
        .service-card:nth-child(2) { animation-delay: 0.2s; }
        .service-card:nth-child(3) { animation-delay: 0.3s; }
        .service-card:nth-child(4) { animation-delay: 0.4s; }
        .service-card:nth-child(5) { animation-delay: 0.5s; }
        .service-card:nth-child(6) { animation-delay: 0.6s; }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.8);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .service-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 15px;
            padding: 2px;
            background: linear-gradient(135deg, #00ffff, #ff00ff);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .service-card:hover::before {
            opacity: 1;
        }

        .service-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 255, 255, 0.3);
        }

        .service-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: inline-block;
            animation: bounce 2s ease-in-out infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .service-card:hover .service-icon {
            animation: spin 1s ease-in-out;
        }

        .service-card h3 {
            color: #00ff88;
            font-size: 1.3rem;
            margin-bottom: 1rem;
        }

        .service-card p {
            color: #cbd5e1;
            font-size: 0.95rem;
        }

        .contact-section {
            text-align: center;
        }

        .contact-methods {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .contact-btn {
            background: linear-gradient(135deg, #00ffff 0%, #ff00ff 100%);
            color: #0a0e27;
            padding: 1rem 2.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        .contact-icon {
            font-size: 1.5rem;
            display: flex;
            align-items: center;
        }

        .contact-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, #ff00ff 0%, #00ffff 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }

        .contact-btn:hover::before {
            opacity: 1;
        }

        .contact-btn:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px rgba(0, 255, 255, 0.5);
        }

        .contact-btn.secondary {
            background: rgba(0, 255, 255, 0.1);
            border: 2px solid #00ffff;
            color: #00ffff;
        }

        .contact-btn.secondary::before {
            background: linear-gradient(135deg, rgba(0, 255, 255, 0.2), rgba(255, 0, 255, 0.2));
        }

        footer {
            text-align: center;
            padding: 2rem;
            color: #64748b;
            font-size: 0.9rem;
        }

        /* Scanline effect */
        .scanline {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                to bottom,
                transparent 0%,
                rgba(0, 255, 255, 0.02) 50%,
                transparent 100%
            );
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 0;
            animation: scan 8s linear infinite;
        }

        @keyframes scan {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100%); }
        }

        /* Portfolio Grid */
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .portfolio-item {
            background: linear-gradient(135deg, rgba(0, 255, 255, 0.05), rgba(255, 0, 255, 0.05));
            border: 2px solid rgba(0, 255, 255, 0.3);
            border-radius: 15px;
            padding: 0;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            animation: fadeInScale 0.6s ease-out backwards;
        }

        .portfolio-item:nth-child(1) { animation-delay: 0.1s; }
        .portfolio-item:nth-child(2) { animation-delay: 0.2s; }
        .portfolio-item:nth-child(3) { animation-delay: 0.3s; }

        .portfolio-image {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, rgba(0, 255, 255, 0.2), rgba(255, 0, 255, 0.2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            border-bottom: 2px solid rgba(0, 255, 255, 0.3);
        }

        .portfolio-content {
            padding: 1.5rem;
        }

        .portfolio-item h3 {
            color: #00ff88;
            font-size: 1.4rem;
            margin-bottom: 0.75rem;
        }

        .portfolio-item p {
            color: #cbd5e1;
            font-size: 0.95rem;
            margin-bottom: 1.25rem;
            line-height: 1.6;
        }

        .portfolio-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #00ffff;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border-bottom: 2px solid transparent;
        }

        .portfolio-link:hover {
            color: #ff00ff;
            border-bottom-color: #ff00ff;
            transform: translateX(5px);
        }

        .portfolio-item::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 15px;
            padding: 2px;
            background: linear-gradient(135deg, #00ffff, #ff00ff);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .portfolio-item:hover::before {
            opacity: 1;
        }

        .portfolio-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 255, 255, 0.3);
        }

        @media (max-width: 968px) {
            .profile-section {
                flex-direction: column;
                text-align: center;
            }

            .profile-content h2 {
                justify-content: center;
            }

            .tools {
                justify-content: center;
            }
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }

            .subtitle {
                font-size: 1.2rem;
            }

            .section {
                padding: 2rem 1.5rem;
            }

            .profile-image {
                width: 150px;
                height: 150px;
                font-size: 4rem;
            }

            .profile-name {
                font-size: 2rem;
            }

            .contact-methods {
                flex-direction: column;
                align-items: center;
            }

            .contact-btn {
                width: 100%;
                max-width: 300px;
                justify-content: center;
            }

            .portfolio-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Animated grid background -->
    <div class="grid-background"></div>
    
    <!-- Glowing orbs -->
    <div class="orb-container">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="orb orb3"></div>
    </div>

    <!-- Scanline effect -->
    <div class="scanline"></div>

    <div class="container">
        <header>
            <h1>AI Automation Specialist</h1>
            <p class="subtitle">Streamlining Business Operations with Intelligent Automation</p>
            <p class="tagline">Transform your workflow with cutting-edge automation solutions</p>
        </header>

        <section class="profile-section">
            <div class="profile-image-container">
                <div class="profile-image">
                    🤖
                </div>
            </div>
            <div class="profile-content">
                <div class="profile-name">[Your Name]</div>
                <h2>🚀 Who I Am</h2>
                <p>
                    Empowering businesses through intelligent automation. I specialize in building custom solutions 
                    that save time, reduce errors, and scale operations seamlessly using AI and leading automation platforms.
                </p>
                <div class="tools">
                    <span class="tool-badge">n8n</span>
                    <span class="tool-badge">Make</span>
                    <span class="tool-badge">Zapier</span>
                    <span class="tool-badge">AI Integration</span>
                    <span class="tool-badge">API Development</span>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>💼 Portfolio</h2>
            <div class="portfolio-grid">
                <div class="portfolio-item">
                    <div class="portfolio-image">
                        🎯
                    </div>
                    <div class="portfolio-content">
                        <h3>Project Name One</h3>
                        <p>Brief description of the automation project, the problem it solved, and the technologies used.</p>
                        <a href="#" class="portfolio-link">View Case Study →</a>
                    </div>
                </div>

                <div class="portfolio-item">
                    <div class="portfolio-image">
                        ⚙️
                    </div>
                    <div class="portfolio-content">
                        <h3>Project Name Two</h3>
                        <p>Brief description of the automation project, the problem it solved, and the technologies used.</p>
                        <a href="#" class="portfolio-link">Watch Demo →</a>
                    </div>
                </div>

                <div class="portfolio-item">
                    <div class="portfolio-image">
                        🚀
                    </div>
                    <div class="portfolio-content">
                        <h3>Project Name Three</h3>
                        <p>Brief description of the automation project, the problem it solved, and the technologies used.</p>
                        <a href="#" class="portfolio-link">View Case Study →</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>💼 Services I Offer</h2>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">⚡</div>
                    <h3>Workflow Automation</h3>
                    <p>Eliminate manual tasks by connecting your apps and automating repetitive processes.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">🤖</div>
                    <h3>AI Integration</h3>
                    <p>Integrate powerful AI models for intelligent document processing and content generation.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">🔗</div>
                    <h3>System Integration</h3>
                    <p>Connect your CRM, databases, and tools to create a unified automated ecosystem.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">📊</div>
                    <h3>Data Automation</h3>
                    <p>Automate data collection, processing, and reporting for real-time insights.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">🛠️</div>
                    <h3>Custom Solutions</h3>
                    <p>Build bespoke automation solutions tailored to your unique business needs.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">📚</div>
                    <h3>Training & Support</h3>
                    <p>Comprehensive training and ongoing support to maximize your automation ROI.</p>
                </div>
            </div>
        </section>

        <section class="section contact-section">
            <h2>📬 Let's Connect</h2>
            <p style="color: #cbd5e1; font-size: 1.1rem; margin-bottom: 2rem;">
                Ready to automate your business? Let's discuss how I can help you save time and scale efficiently.
            </p>
            <div class="contact-methods">
                <a href="mailto:your.email@example.com" class="contact-btn">
                    <span class="contact-icon">📧</span>
                    Email Me
                </a>
                <a href="#" class="contact-btn secondary">
                    <span class="contact-icon">📅</span>
                    Schedule a Call
                </a>
            </div>
        </section>

        <footer>
            <p>&copy; 2025 AI Automation Specialist. Building the future of work, one workflow at a time.</p>
        </footer>
    </div>
</body>
</html>